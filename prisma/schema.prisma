// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ======================================================
// ENUMS
// ======================================================

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ======================================================
// MODELS
// ======================================================

model Company {
  id         Int       @id @default(autoincrement())
  name       String
  domain     String?   @unique // domínio corporativo (ex: empresa.com)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relacionamentos
  employees      Employee[]
  invitations Invitation[]
  surveys     Survey[]
}

// ------------------------------------------------------

model Employee {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  name       String?
  password   String
  role       Role      @default(EMPLOYEE)
  isActive   Boolean   @default(true)

  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id])

  // Ex: para métricas futuras ou pulse responses
  surveyResponses SurveyResponse[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ------------------------------------------------------

model Invitation {
  id          Int               @id @default(autoincrement())
  email       String
  token       String            @unique
  role        Role              @default(EMPLOYEE)
  status      InvitationStatus  @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  companyId   Int
  company     Company           @relation(fields: [companyId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// MODELOS FUTUROS (Pulse Surveys)
// ------------------------------------------------------

model Survey {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  isActive    Boolean   @default(true)

  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])

  questions   SurveyQuestion[]
  runs        SurveyRun[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SurveyQuestion {
  id          Int       @id @default(autoincrement())
  text        String
  type        String    // Ex: "scale", "boolean", "text"
  order       Int

  surveyId    Int
  survey      Survey    @relation(fields: [surveyId], references: [id])
}

model SurveyRun {
  id          Int       @id @default(autoincrement())
  surveyId    Int
  survey      Survey    @relation(fields: [surveyId], references: [id])

  sentAt      DateTime?
  weekRef     String    // Ex: "2025-W44"
  responses   SurveyResponse[]
  createdAt   DateTime  @default(now())
}

model SurveyResponse {
  id          Int       @id @default(autoincrement())
  runId       Int
  run         SurveyRun @relation(fields: [runId], references: [id])

  employeeId      Int
  employee        Employee      @relation(fields: [employeeId], references: [id])

  answers     Json      // respostas em JSON (perguntas x respostas)
  submittedAt DateTime  @default(now())
}
